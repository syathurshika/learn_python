name=input("Enter your name:")
score=int(input("Enter your score:"))

if score>=90:
    print(f"{name}, you scored {score} your grade is A")
elif score>=80:
    print(f"{name}, you scored {score} your grade is B")
elif score>=70:
    print(f"{name}, you scored {score} your grade is C")
elif score>=60:
    print(f"{name}, you scored {score} your grade is S")
else:
    print(f"{name}, you scored {score} your grade is F")